# ---------------------------------------------------------------------------
# Spend Policy Intelligence — environment
#
# The entire demo runs with no configuration at all. Copy this file to
# `.env.local` only if you want to switch the explanation layer to Claude.
# ---------------------------------------------------------------------------

# "mock"   — deterministic explanations, no network calls. This is the default
#            and is what the demo is scripted against.
# "claude" — the explanation prose is written by Claude. The verdict, risk
#            level, cited clauses and every figure still come from the
#            deterministic policy engine; the model only rewrites the wording.
AI_PROVIDER=mock

# Only read on the server, and only when AI_PROVIDER=claude. Leave blank to
# stay in mock mode. Never commit a real key.
ANTHROPIC_API_KEY=
